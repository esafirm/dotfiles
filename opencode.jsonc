{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["opencode", "opencode-go", "openai"],
  "mcp": {
    "servers": {
      "android-studio": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/stream"
      },
      "firebase": {
        "type": "local",
        "command": [
          "firebase",
          "mcp",
          "--only",
          "crashlytics"
        ]
      }
    }
  },
  "permissions": [
    { "action": "android-studio_*", "resource": "*", "effect": "allow" },
    { "action": "android-studio_apply_patch", "resource": "*", "effect": "deny" },
    { "action": "android-studio_create_new_file", "resource": "*", "effect": "deny" },
    { "action": "android-studio_execute_terminal_command", "resource": "*", "effect": "deny" },
    { "action": "android-studio_replace_text_in_file", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/secret_dir/*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/secrets/*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*ai-trash.sh*", "effect": "allow" },
    { "action": "shell", "resource": "*review-pr.sh*", "effect": "allow" },
    { "action": "shell", "resource": "adb devices", "effect": "allow" },
    { "action": "shell", "resource": "adb logcat*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell cmd*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell content query*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell dumpsys*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell getprop*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell pm list*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell pm path*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell ps*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell screencap*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell service*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell settings*", "effect": "allow" },
    { "action": "shell", "resource": "adb shell wm*", "effect": "allow" },
    { "action": "shell", "resource": "android layout*", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status *", "effect": "allow" },
    { "action": "shell", "resource": "gh gist list", "effect": "allow" },
    { "action": "shell", "resource": "gh gist list *", "effect": "allow" },
    { "action": "shell", "resource": "gh gist view", "effect": "allow" },
    { "action": "shell", "resource": "gh gist view *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *", "effect": "allow" },
    { "action": "shell", "resource": "gh label list", "effect": "allow" },
    { "action": "shell", "resource": "gh label list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
    { "action": "shell", "resource": "gh release list", "effect": "allow" },
    { "action": "shell", "resource": "gh release list *", "effect": "allow" },
    { "action": "shell", "resource": "gh release view", "effect": "allow" },
    { "action": "shell", "resource": "gh release view *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *", "effect": "allow" },
    { "action": "shell", "resource": "gh run list", "effect": "allow" },
    { "action": "shell", "resource": "gh run list *", "effect": "allow" },
    { "action": "shell", "resource": "gh run view", "effect": "allow" },
    { "action": "shell", "resource": "gh run view *", "effect": "allow" },
    { "action": "shell", "resource": "gh search", "effect": "allow" },
    { "action": "shell", "resource": "gh search *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list *", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git diff-tree", "effect": "allow" },
    { "action": "shell", "resource": "git diff-tree *", "effect": "allow" },
    { "action": "shell", "resource": "git log", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git show", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent get *", "effect": "allow" },
    { "action": "shell", "resource": "herdr agent read *", "effect": "allow" },
    { "action": "shell", "resource": "javap *", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "rg", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "rtk cat *", "effect": "allow" },
    { "action": "shell", "resource": "rtk find", "effect": "allow" },
    { "action": "shell", "resource": "rtk find *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git diff-tree *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git log *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git ls-tree *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git rev-parse", "effect": "allow" },
    { "action": "shell", "resource": "rtk git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git show *", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status", "effect": "allow" },
    { "action": "shell", "resource": "rtk git status *", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep", "effect": "allow" },
    { "action": "shell", "resource": "rtk grep *", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls", "effect": "allow" },
    { "action": "shell", "resource": "rtk ls *", "effect": "allow" },
    { "action": "shell", "resource": "rtk rg", "effect": "allow" },
    { "action": "shell", "resource": "rtk rg *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "strings *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "unzip -l *", "effect": "allow" },
    { "action": "shell", "resource": "unzip -p *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" }
  ]
}
