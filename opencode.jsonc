{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".config/claude/CLAUDE.md"
  ],
  "enabled_providers": ["opencode", "opencode-go"],
  "mcp": {
    "android-studio": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream"
    },
    "firebase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firebase-tools@latest",
        "mcp",
        "--only",
        "crashlytics"
      ]
    }
  },
  "skills": {
    "paths": [".config/claude/skills"]
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git diff-tree": "allow",
      "git diff-tree *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "cat *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "which *": "allow",
      "wc *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "rm *": "deny",
      "echo *": "allow",
      "rtk git log *": "allow",
      "rtk git show *": "allow",
      "rtk git diff *": "allow",
      "rtk git diff-tree *": "allow",
      "rtk git status": "allow",
      "rtk git status *": "allow",
      "rtk git ls-tree *": "allow",
      "rtk git rev-parse": "allow",
      "rtk git rev-parse *": "allow",
      "rtk rg": "allow",
      "rtk rg *": "allow",
      "rtk grep": "allow",
      "rtk grep *": "allow",
      "rtk find": "allow",
      "rtk find *": "allow",
      "rtk cat *": "allow",
      "rtk ls": "allow",
      "rtk ls *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr view": "allow",
      "gh pr diff": "allow",
      "gh pr list *": "allow",
      "gh pr list": "allow",
      "gh pr status *": "allow",
      "gh pr status": "allow",
      "gh pr checks *": "allow",
      "gh pr checks": "allow",
      "gh issue list *": "allow",
      "gh issue list": "allow",
      "gh issue view *": "allow",
      "gh issue view": "allow",
      "gh repo view *": "allow",
      "gh repo view": "allow",
      "gh release list *": "allow",
      "gh release list": "allow",
      "gh release view *": "allow",
      "gh release view": "allow",
      "gh run list *": "allow",
      "gh run list": "allow",
      "gh run view *": "allow",
      "gh run view": "allow",
      "gh workflow list *": "allow",
      "gh workflow list": "allow",
      "gh label list *": "allow",
      "gh label list": "allow",
      "gh search *": "allow",
      "gh search": "allow",
      "gh gist list *": "allow",
      "gh gist list": "allow",
      "gh auth status *": "allow",
      "gh auth status": "allow",
      "*review-pr.sh*": "allow",
      "adb devices": "allow",
      "adb shell pm list*": "allow",
      "adb shell pm path*": "allow",
      "adb shell dumpsys*": "allow",
      "adb shell getprop*": "allow",
      "adb shell settings*": "allow",
      "adb shell content query*": "allow",
      "adb shell cmd*": "allow",
      "adb shell wm*": "allow",
      "adb shell ps*": "allow",
      "adb shell service*": "allow",
      "adb shell screencap*": "allow",
      "adb logcat*": "allow"
    },
    "android-studio_*": "allow",
    "android-studio_execute_terminal_command": "deny",
    "android-studio_replace_text_in_file": "deny",
    "android-studio_apply_patch": "deny",
    "android-studio_create_new_file": "deny",
    "external_directory": {
      "~/secrets/**": "deny",
      "~/secret_dir/**": "deny",
      "*": "allow"
    }
  }
}
