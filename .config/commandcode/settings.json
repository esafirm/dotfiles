{
  "skills": [
    "~/.claude/skills"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read|write|edit|shell",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.commandcode/hooks/guard-secrets.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='command-code' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 10
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='command-code' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 10
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='command-code' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
