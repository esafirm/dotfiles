{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "Bash(pwd:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(rtk git log:*)",
      "Bash(rtk git show:*)",
      "Bash(rtk git diff:*)",
      "Bash(rtk git diff-tree:*)",
      "Bash(rtk git status:*)",
      "Bash(rtk git ls-tree:*)",
      "Bash(rtk git rev-parse:*)",
      "Bash(rtk rg:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk find:*)",
      "Bash(rtk cat:*)",
      "Bash(rtk ls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(adb devices)",
      "Bash(android layout:*)",
      "Bash(adb shell pm list:*)",
      "Bash(adb shell pm path:*)",
      "Bash(adb shell dumpsys:*)",
      "Bash(adb shell getprop:*)",
      "Bash(adb shell settings:*)",
      "Bash(adb shell content query:*)",
      "Bash(adb shell cmd:*)",
      "Bash(adb shell wm:*)",
      "Bash(adb shell ps:*)",
      "Bash(adb shell service:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb logcat:*)",
      "Bash(~/.config/opencode/scripts/ai-trash.sh:*)",
      "Bash(/Users/esafirm/.config/opencode/scripts/ai-trash.sh:*)",
      "mcp__play-store",
      "mcp__llm-wiki",
      "mcp__android-studio"
    ],
    "deny": [
      "Bash(rm:*)",
      "mcp__android-studio__apply_patch",
      "mcp__android-studio__create_new_file",
      "mcp__android-studio__execute_terminal_command",
      "mcp__android-studio__replace_text_in_file"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/esafirm/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/esafirm/.claude/hooks/rtk-rewrite.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "auto"
}
