{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "Bash(pwd:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(adb devices)",
      "Bash(android layout:*)",
      "Bash(adb shell pm list:*)",
      "Bash(adb shell pm path:*)",
      "Bash(adb shell dumpsys:*)",
      "Bash(adb shell getprop:*)",
      "Bash(adb shell settings:*)",
      "Bash(adb shell content query:*)",
      "Bash(adb shell cmd:*)",
      "Bash(adb shell wm:*)",
      "Bash(adb shell ps:*)",
      "Bash(adb shell service:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb logcat:*)",
      "Bash(~/.config/opencode/scripts/ai-trash.sh:*)",
      "mcp__play-store",
      "mcp__llm-wiki",
      "mcp__android-studio"
    ],
    "deny": [
      "Bash(rm:*)",
      "mcp__android-studio__apply_patch",
      "mcp__android-studio__create_new_file",
      "mcp__android-studio__execute_terminal_command",
      "mcp__android-studio__replace_text_in_file"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "GHOSTEX_AGENT='claude' $HOME/.local/share/ghostex/hooks/agent-shell-notify.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "auto"
}
