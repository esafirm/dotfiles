{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 36500,
  "env": {
    "API_TIMEOUT_MS": "3000000",
    "MCP_TIMEOUT": "60000"
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "Bash(pwd:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(which:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(echo:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(adb devices)",
      "Bash(android layout:*)",
      "Bash(adb shell pm list:*)",
      "Bash(adb shell pm path:*)",
      "Bash(adb shell dumpsys:*)",
      "Bash(adb shell getprop:*)",
      "Bash(adb shell settings:*)",
      "Bash(adb shell content query:*)",
      "Bash(adb shell cmd:*)",
      "Bash(adb shell wm:*)",
      "Bash(adb shell ps:*)",
      "Bash(adb shell service:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb logcat:*)",
      "Bash(~/.config/opencode/scripts/ai-trash.sh:*)",
      "mcp__play-store",
      "mcp__llm-wiki",
      "mcp__android-studio"
    ],
    "deny": [
      "Bash(rm:*)",
      "mcp__android-studio__apply_patch",
      "mcp__android-studio__create_new_file",
      "mcp__android-studio__execute_terminal_command",
      "mcp__android-studio__replace_text_in_file"
    ]
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.ghostex/hooks/agent-shell-notify.sh\"; [ -f \"$f\" ] && GHOSTEX_AGENT='claude' /bin/bash \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public (gh visibility check not queryable here; remote is github.com:esafirm/fomo-reader.git, no public indicator found)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: not queryable here — gh API unavailable; treat default branch protections as unknown",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (esafirm/fomo-reader on github.com) and its remote(s) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; this repo's `.env.local` and `.env*.local` files hold local secrets and must not be committed or shared",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Next.js app for browsing tech company reviews, salary data, and industry feed — repo: fomo-reader)",
      "**Trusted repo**: ~/Documents/nolambda/fomo-reader (remote: github.com:esafirm/fomo-reader.git) — routine edits, commits, and pushes to this repo and its configured remote are trusted",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "voiceEnabled": true
}
