# Ghostty config — managed by dotfiles (~/.config/ghostty/config)
# See: https://ghostty.org/docs/config

shell-integration = zsh
term = xterm-256color

# Window
window-decoration = false
window-height = 80
window-width = 180
window-padding-x = 0
window-padding-y = 0
quick-terminal-animation-duration = 0.1
resize-overlay-duration = 2500ms

# Shared appearance (Cyberdream-inspired)
config-file = appearance
mouse-hide-while-typing = true

# macOS Option key handling
# Default (false) makes Opt+P type π and Opt+N type ˜, so Alt-based apps
# (zsh readline, herdr) never see Alt+P / Alt+N / Opt+Backspace.
# `left` = left Opt acts as Alt, right Opt still types special chars.
# Use `true` if you have no need for Opt-typed unicode chars.
macos-option-as-alt = left

# Remove the default "write scrollback to file" bindings: cmd+shift+j dumps the
# whole scrollback to a temp file and pastes its path into the terminal.
keybind = cmd+shift+j=unbind
keybind = cmd+shift+option+j=unbind

# Word delete (macOS Opt+Backspace / Opt+Fn+Backspace).
# Ghostty >=1.2 removed the builtin, so restore it explicitly:
# \x1b\x7f = ESC DEL = backward-kill-word in zsh emacs mode.
keybind = opt+backspace=text:\x1b\x7f
keybind = opt+delete=text:\x1bd

# herdr owns Alt-bindings (alt+p / alt+n / alt+o etc. per ~/.config/herdr/config.toml),
# so no tmux-style alt keybinds here. Ghostty keybinds would swallow them
# before herdr ever sees them. The presentation macro below is the exception:
# it intentionally forwards Herdr chords.
confirm-close-surface = false

# Presentation/reader mode. Sends Herdr's prefix+shift+z chord; the mode script
# handles zoom, font size, fullscreen, and replays the sidebar chord.
keybind = cmd+alt+z=text:\x02Z
