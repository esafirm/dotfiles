{
  "effortLevel": "high",
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk_9router",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "i-have-adhd": {
      "source": {
        "path": "$DOT/i-have-adhd",
        "source": "directory"
      }
    }
  },
  "general": {
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    }
  },
  "hasCompletedOnboarding": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '$HOME/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "opus",
  "output": {
    "format": "text"
  },
  "permissions": {
    "allow": [
      "Bash(pwd:*)",
      "Bash(git rev-parse:*)"
    ]
  },
  "ui": {
    "showMemoryUsage": true,
    "showModelInfoInChat": true,
    "theme": "Dracula"
  }
}
