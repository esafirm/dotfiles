#!/usr/bin/env python3
"""Verify Claude Code MCP setup matches opencode.jsonc (the source of truth).

Checks:
  - servers registered by setup-symlink.sh (claude_mcp lines) match opencode `mcp.servers`
  - MCP permissions in .config/claude/settings.json match opencode `permissions`
  - Claude MCP_TIMEOUT covers the largest opencode startup timeout
"""
import json
import re
import shlex
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OPENCODE = ROOT / "opencode.jsonc"
SETUP = ROOT / "setup-symlink.sh"
CLAUDE_SETTINGS = ROOT / ".config/claude/settings.json"


def load_jsonc(path):
    text = path.read_text()
    out, i, in_str = [], 0, False
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            i = text.find("\n", i)
            if i == -1:
                break
            continue
        elif text.startswith("/*", i):
            i = text.index("*/", i) + 2
            continue
        else:
            out.append(c)
        i += 1
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))


def opencode_to_claude(server):
    if server.get("type") == "remote":
        return {"type": "http", "url": server["url"]}
    command = server["command"]
    spec = {"type": "stdio", "command": command[0]}
    if command[1:]:
        spec["args"] = command[1:]
    return spec


def claude_servers():
    servers = {}
    for line in SETUP.read_text().splitlines():
        parts = shlex.split(line, comments=True)
        if len(parts) == 3 and parts[0] == "claude_mcp":
            spec = json.loads(parts[2])
            spec.setdefault("type", "stdio")
            if spec.get("args") == []:
                del spec["args"]
            servers[parts[1]] = spec
    return servers


def main():
    errors = []
    opencode = load_jsonc(OPENCODE)
    settings = json.loads(CLAUDE_SETTINGS.read_text())

    oc_servers = {
        name: s
        for name, s in opencode.get("mcp", {}).get("servers", {}).items()
        if s.get("enabled", True)
    }
    expected = {name: opencode_to_claude(s) for name, s in oc_servers.items()}
    actual = claude_servers()

    for name in sorted(expected.keys() - actual.keys()):
        errors.append(f"server '{name}' is in opencode.jsonc but not registered in setup-symlink.sh")
    for name in sorted(actual.keys() - expected.keys()):
        errors.append(f"server '{name}' is registered in setup-symlink.sh but not in opencode.jsonc")
    for name in sorted(expected.keys() & actual.keys()):
        if expected[name] != actual[name]:
            errors.append(
                f"server '{name}' differs\n    opencode: {json.dumps(expected[name])}\n    claude:   {json.dumps(actual[name])}"
            )

    # opencode `<server>_*` / `<server>_<tool>` -> claude `mcp__<server>` / `mcp__<server>__<tool>`
    expected_perms = {"allow": set(), "deny": set()}
    for rule in opencode.get("permissions", []):
        server = next((n for n in oc_servers if rule["action"].startswith(n + "_")), None)
        if server is None or rule.get("effect") not in expected_perms:
            continue
        tool = rule["action"][len(server) + 1 :]
        claude_rule = f"mcp__{server}" if tool == "*" else f"mcp__{server}__{tool}"
        expected_perms[rule["effect"]].add(claude_rule)

    for effect, rules in expected_perms.items():
        actual_rules = {
            r for r in settings.get("permissions", {}).get(effect, []) if r.startswith("mcp__")
        }
        for r in sorted(rules - actual_rules):
            errors.append(f"permission '{r}' missing from claude permissions.{effect}")
        for r in sorted(actual_rules - rules):
            errors.append(f"permission '{r}' in claude permissions.{effect} has no opencode counterpart")

    startup = max((s.get("timeout", {}).get("startup", 0) for s in oc_servers.values()), default=0)
    if startup:
        timeout = int(settings.get("env", {}).get("MCP_TIMEOUT", 0))
        if timeout < startup:
            errors.append(f"claude env.MCP_TIMEOUT ({timeout}) is below opencode startup timeout ({startup})")

    if errors:
        print("MCP config drift between opencode and Claude:", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1
    print(f"MCP config in sync ({len(expected)} servers)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
