#!/usr/bin/env python3
"""Block pushes that add secrets or machine-specific absolute paths.

Reads the ref lines git hands a pre-push hook on stdin (see githooks(5)) and
scans committed blobs in every outgoing commit, not working-tree copies.

Usage:
  verify-content            # pre-push mode, reads refs from stdin
  verify-content --all      # audit every tracked file
  verify-content --history  # audit all locally reachable history
  verify-content --self-test

A line can opt out with `content-check: ignore` when a match is deliberate.
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ZERO = "0" * 40

# Real usernames are a leak. These show up in docs as placeholders and are fine.
PLACEHOLDER_USERS = {
    "me",
    "user",
    "username",
    "you",
    "your",
    "yourname",
    "name",
    "example",
    "linuxbrew",
    "shared",
}

ABSOLUTE_PATH_PATTERNS = [
    re.compile(r"(?<![\w.])/(?:Users|home)/([A-Za-z0-9._-]+)/"),
    re.compile(r"(?i)\b[A-Za-z]:[\\/]Users[\\/]([A-Za-z0-9._-]+)[\\/]"),
]

SECRET_PATTERNS = [
    ("private key", re.compile(r"-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----")),
    ("API key", re.compile(r"\bsk-(?:ant-)?[A-Za-z0-9_-]{20,}")),
    ("GitHub token", re.compile(r"\b(?:gh[pousr]|github_pat)_[A-Za-z0-9_]{20,}")),
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}")),
    ("Stripe live key", re.compile(r"\b(?:sk|rk)_live_[A-Za-z0-9]{16,}")),
    ("JWT", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}")),
    (
        "credential assignment",
        re.compile(
            r"(?i)\b(?:[a-z0-9]+[_-])*(?:api[_-]?key|secret|token|password|passwd|client[_-]?secret)\b"
            r"[\"']?\s*[:=]\s*[\"']?([A-Za-z0-9_+/-]{24,})"
        ),
    ),
    (
        "quoted credential",
        re.compile(
            r"(?i)\b(?:[a-z0-9]+[_-])*(?:api[_-]?key|secret|token|password|passwd|client[_-]?secret)\b"
            r"[\"']?\s*[:=]\s*([\"'])([^\"'\n]{8,})\1"
        ),
    ),
    ("authorization header", re.compile(r"(?i)\b(?:Bearer|Basic)\s+[A-Za-z0-9_+/=-]{16,}")),
    ("URL password", re.compile(r"[a-zA-Z][a-zA-Z0-9+.-]*://[^\s/:@]+:([^\s/@]+)@")),
]

# Values that look like a credential but are documentation.
SECRET_PLACEHOLDERS = re.compile(
    r"(?i)^(?:your[-_].*|example(?:[-_].*)?|placeholder|redacted|changeme|dummy|fake|x{4,}|<[^>]+>|\$.*|\{.*)$"
)

IGNORE_LINE = re.compile(r"content-check:\s*ignore")


def git(*args: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(ROOT), *args],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout


def git_ok(*args: str) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(ROOT), *args],
        capture_output=True,
        text=True,
    )
    return result.stdout if result.returncode == 0 else None


def changed_in_commit(sha: str) -> set[str]:
    return {
        p
        for p in git(
            "diff-tree", "--root", "--no-renames", "-m", "-r", "--no-commit-id", "--name-only", "-z", sha
        ).split("\0")
        if p
    }


def commits_for_push(ref_lines: str) -> set[str]:
    """Do not exclude other remotes: they may not share the destination's history."""
    commits: set[str] = set()
    for line in ref_lines.splitlines():
        parts = line.split()
        if len(parts) != 4:
            raise ValueError("malformed pre-push ref input")
        _, local_sha, _, remote_sha = parts
        if not all(re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", sha) for sha in (local_sha, remote_sha)):
            raise ValueError("invalid object ID in pre-push input")
        if set(local_sha) == {ZERO[0]}:
            continue  # deleting a ref pushes no content
        # Tags pointing directly at blobs or trees cannot use the commit scanner.
        git("cat-file", "-e", local_sha + "^{commit}")
        args = ["rev-list", local_sha]
        # A fresh branch or an unavailable remote object needs a full-history scan.
        if set(remote_sha) != {ZERO[0]} and git_ok("cat-file", "-e", remote_sha + "^{commit}") is not None:
            args.append("^" + remote_sha)
        commits.update(git(*args).split())
    return commits


def all_tracked_paths() -> set[str]:
    return {p for p in git("ls-files", "-z").split("\0") if p}


def check_text(relpath: str, text: str) -> list[str]:
    issues: list[str] = []
    for lineno, line in enumerate(text.splitlines(), 1):
        if IGNORE_LINE.search(line):
            continue
        for pattern in ABSOLUTE_PATH_PATTERNS:
            for match in pattern.finditer(line):
                if match.group(1).lower() in PLACEHOLDER_USERS:
                    continue
                issues.append(
                    f"{relpath}:{lineno}: absolute home path "
                    "- use ~ or $HOME"
                )
        for name, pattern in SECRET_PATTERNS:
            for match in pattern.finditer(line):
                if name == "quoted credential":
                    value = match.group(2)
                elif name in {"credential assignment", "URL password"}:
                    value = match.group(1)
                else:
                    value = match.group(0)
                if SECRET_PLACEHOLDERS.fullmatch(value):
                    continue
                # Never echo the value itself.
                issues.append(f"{relpath}:{lineno}: possible {name}")
    return issues


def check_data(relpath: str, data: bytes) -> list[str]:
    path = Path(relpath)
    sensitive = (
        path.name in {"secrets", ".env", "auth.json", "credentials.json", ".netrc", ".npmrc", ".pypirc", "id_rsa", "id_ed25519"}
        or path.name.startswith(".env.") and path.name not in {".env.example", ".env.sample", ".env.template"}
        or path.suffix.lower() in {".pem", ".key", ".p12", ".pfx", ".jks", ".keystore"}
        or bool({"secret_dir", "keepsecret", ".ssh", ".aws"} & set(path.parts))
    )
    # Android's shared debug key is deliberately public, never a release key.
    if sensitive and relpath != "android/debug.keystore":
        return [f"{relpath}: sensitive filename must not be tracked"]
    if b"\0" in data[:8000]:
        return []
    return check_text(relpath, data.decode("utf-8", "replace"))


def check_files(paths: set[str]) -> list[str]:
    issues: list[str] = []
    for relpath in sorted(paths):
        path = ROOT / relpath
        if path.is_symlink():
            issues.extend(check_text(relpath, os.readlink(path)))
            continue
        if not path.is_file():
            continue
        issues.extend(check_data(relpath, path.read_bytes()))
    return issues


def check_commits(commits: set[str]) -> list[str]:
    issues: list[str] = []
    seen: set[tuple[str, str]] = set()
    for sha in sorted(commits):
        paths = changed_in_commit(sha)
        for entry in git("ls-tree", "-r", "-z", sha).split("\0"):
            if not entry:
                continue
            metadata, relpath = entry.split("\t", 1)
            mode, kind, blob = metadata.split()
            if relpath not in paths or (relpath, blob) in seen:
                continue
            seen.add((relpath, blob))
            if kind != "blob":
                issues.append(f"{relpath} [{sha[:12]}]: cannot scan submodule content")
                continue
            data = subprocess.run(
                ["git", "-C", str(ROOT), "cat-file", "blob", blob],
                check=True, capture_output=True,
            ).stdout
            if mode == "120000":
                found = check_text(relpath, data.decode("utf-8", "replace"))
            else:
                found = check_data(relpath, data)
            issues.extend(f"{issue} [commit {sha[:12]}]" for issue in found)
    return issues


def self_test() -> None:
    cases = [
        ("x", "key = ghp_" + "a" * 36, True),
        ("x", "key = sk-ant-api03-" + "a" * 40, True),
        ("x", "-----BEGIN OPENSSH PRIVATE KEY-----", True),  # content-check: ignore
        ("x", "key = AKIA" + "A" * 16, True),
        ("x", "key: sk_live_" + "a" * 24, True),
        ("x", "path = /Users/esafirm/dotfiles", True),  # content-check: ignore
        ("x", "path = C:\\Users\\esafirm\\dotfiles", True),
        ("x", "path = /Users/me/foo", False),
        ("x", "path = ~/.config/opencode", False),
        ("x", 'token = "your-token-goes-here-please-replace"', False),
        ("x", "content-check: ignore /Users/esafirm/x", False),
    ]
    failed = [
        line
        for _, line, expected in cases
        if bool(check_text("x", line)) is not expected
    ]
    if failed:
        print("self-test failed:", *failed, sep="\n  ")
        sys.exit(1)
    print(f"self-test ok ({len(cases)} cases)")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--all", action="store_true")
    modes.add_argument("--history", action="store_true")
    modes.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        self_test()
        return 0

    try:
        if args.all:
            issues = check_files(all_tracked_paths())
        else:
            commits = set(git("rev-list", "--all").split()) if args.history else commits_for_push(sys.stdin.read())
            issues = check_commits(commits)
    except (OSError, ValueError, subprocess.CalledProcessError):
        print("verify-content: unable to complete scan, push blocked", file=sys.stderr)
        return 1

    if not issues:
        return 0

    print("verify-content: push blocked", file=sys.stderr)
    for issue in issues:
        print(f"  {issue}", file=sys.stderr)
    print(
        "\nRemove the value, or mark a deliberate match with `content-check: ignore`.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
